rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // ヘルパー関数
    // ========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (userDoc().role == 'admin' || userDoc().role == 'master');
    }

    function isWarehouse() {
      return isSignedIn() && userDoc().role == 'warehouse';
    }

    function isStaff() {
      return isSignedIn() && userDoc().role == 'staff';
    }

    function isSalon() {
      return isSignedIn() && userDoc().role == 'salon';
    }

    function isDealer() {
      return isSignedIn() && userDoc().role == 'dealer';
    }

    // subRole が 'admin' or 'staff' のいずれかで明示されていること（未設定拒否）
    // dealer / salon のみ該当。移行完了後は必須。
    function hasValidSubRole() {
      return isSignedIn()
        && userDoc().subRole is string
        && (userDoc().subRole == 'admin' || userDoc().subRole == 'staff');
    }

    // dealer / salon の admin サブロール（書き込み可能）
    // 未設定は拒否（移行完了を前提）
    function isSalonAdmin() {
      return isSalon() && hasValidSubRole() && userDoc().subRole == 'admin';
    }
    // salon の staff サブロール（現場運用用：create可能、update/delete不可）
    function isSalonStaff() {
      return isSalon() && hasValidSubRole() && userDoc().subRole == 'staff';
    }
    function isDealerAdmin() {
      return isDealer() && hasValidSubRole() && userDoc().subRole == 'admin';
    }

    // 在庫管理権限: admin, staff, warehouse
    function hasInventoryAccess() {
      return isAdmin() || isStaff() || isWarehouse();
    }

    // ========================================
    // ERP Phase 1: 共通ヘルパー
    // 設計書: docs/04_ERP_DATA_MODEL.md §6
    // Phase 1 の ERP 画面は admin / internal(=staff) のみ有効
    // factory / supplier / warehouse / dealer / salon は erp_ 系 collection アクセス不可
    // ========================================
    function isErpUser() {
      return isSignedIn() && (isAdmin() || isStaff());
    }

    // customers/{customerId} の salonCompanyName がログインユーザーの
    // companyName と一致するか。visits/recommendations サブコレクションで
    // 繰り返し呼ばれるので helper に抽出した（DRY 化）。
    function isMyCustomer(customerId) {
      return get(/databases/$(database)/documents/customers/$(customerId))
                .data.salonCompanyName == userDoc().companyName;
    }

    // 招待・ユーザー作成時の subRole 必須バリデーション。
    // role が dealer / salon の場合は subRole が 'admin' or 'staff' 必須。
    // それ以外の role（master / admin / staff / warehouse / client）では subRole は無くてもよい。
    // permissions.js の strict モード（2026-04-17 カットオーバー）と整合。
    function hasRequiredSubRoleForInvite(data) {
      return !(data.role in ['dealer', 'salon'])
        || (data.subRole is string && (data.subRole == 'admin' || data.subRole == 'staff'));
    }

    // ========================================
    // users コレクション
    // 本人は自分のドキュメントだけ読める
    // 全スタッフが一覧を読める（チャットDM用）
    // 書き込みは本人 or admin のみ
    // ========================================
    match /users/{uid} {
      allow get:    if isSignedIn();
      allow list:   if isSignedIn();
      // create 時は role が dealer/salon なら subRole 必須（strict モード整合）
      allow create: if (isAdmin()
                        || (isSelf(uid)
                            && request.resource.data.role in ['staff', 'dealer', 'warehouse', 'salon', 'client']
                            && request.resource.data.uid == uid))
                     && hasRequiredSubRoleForInvite(request.resource.data);
      // update も dealer/salon に昇格するケースで subRole を要求する
      allow update: if (isAdmin()
                        || (isSelf(uid)
                            && request.resource.data.role == resource.data.role))
                     && hasRequiredSubRoleForInvite(request.resource.data);
      allow delete: if isAdmin();
    }

    // ========================================
    // salons コレクション
    // 全スタッフ読める。書き込みは admin と担当営業のみ
    // ========================================
    match /salons/{salonId} {
      allow read:   if isSignedIn();
      allow create: if isAdmin() || isStaff();
      allow update: if isAdmin() || isStaff()
                     || (isSignedIn()
                         && resource.data.assignedUid == request.auth.uid);
      allow delete: if isAdmin();

      // メモ履歴サブコレクション（追記型）
      match /notes/{noteId} {
        allow read:   if isSignedIn();
        allow create: if isSignedIn()
                       && request.resource.data.authorUid == request.auth.uid;
        allow update: if false; // 編集不可
        allow delete: if isAdmin(); // 削除は admin のみ
      }
    }

    // ========================================
    // attendance コレクション
    // 本人は自分のだけ読み書き可。admin は全員分読み書き可（修正用）
    // docId は ${uid}_${YYYY-MM-DD} 形式に制約
    // ========================================
    match /attendance/{recordId} {
      allow read:   if isSignedIn()
                     && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                     && request.resource.data.uid == request.auth.uid
                     && recordId.matches('^' + request.auth.uid + '_\\d{4}-\\d{2}-\\d{2}$');
      allow update: if (isSignedIn()
                        && resource.data.uid == request.auth.uid)
                     || isAdmin();
      allow delete: if isAdmin();
    }

    // ========================================
    // attendance_monthly コレクション（集計キャッシュ）
    // Step 3 で Cloud Functions が書き込む。今は admin の手動書き込み許可
    // ========================================
    match /attendance_monthly/{recordId} {
      allow read:  if isSignedIn()
                    && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ========================================
    // orders コレクション（legacy 受注、cutover で readOnly 化）
    // 設計書: docs/04_ERP_DATA_MODEL.md §7
    // ポリシー:
    //   - read: 既存通り（admin/staff 全件、dealer/salon は自社のみ）
    //   - create: 既存通り（BcartImport が erp_orders 対応完了まで互換維持）
    //   - update:
    //       * 通常（isDeprecated != true）: admin/staff 可
    //       * cutover 済み（isDeprecated == true）: admin のみ、かつ
    //         isDeprecated 関連フィールドの修正（やり直し・取消）に限定
    //   - delete: 既存通り禁止（write で admin/staff に限定、個別 delete 許可なし）
    // ========================================
    match /orders/{orderId} {
      allow read:  if isSignedIn()
                    && (
                      isAdmin() || isStaff()
                      || (isDealer()
                          && userDoc().get('dealerCode', '') != ''
                          && resource.data.get('dealerCode', '') == userDoc().dealerCode)
                      || (isSalon()
                          && resource.data.companyName == userDoc().companyName)
                    );
      allow create: if isAdmin() || isStaff();
      allow update: if (
                      // cutover 前 or 未付与：通常の admin/staff 更新を許容
                      !(resource.data.get('isDeprecated', false) == true)
                      && (isAdmin() || isStaff())
                    ) || (
                      // cutover 後：admin のみ、かつ isDeprecated 関連フィールドのみ触れる
                      resource.data.get('isDeprecated', false) == true
                      && isAdmin()
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['isDeprecated', 'deprecatedAt', 'deprecatedBy', 'migratedToErpOrderId'])
                    );
      allow delete: if false;
    }

    // ========================================
    // dealerSalons コレクション（代理店↔サロン紐付け）
    // admin のみ読み書き可
    // ========================================
    match /dealerSalons/{docId} {
      allow read:  if isSignedIn()
                    && (
                      isAdmin() || isStaff()
                      || (isDealer()
                          && userDoc().get('dealerCode', '') != ''
                          && resource.data.dealerCode == userDoc().dealerCode)
                    );
      allow write: if isAdmin();
    }

    // ========================================
    // kickbacks コレクション（キックバック清算書）
    // admin は全件読み書き。dealer は自社の清算書のみ読める
    // ========================================
    match /kickbacks/{docId} {
      allow read:  if isSignedIn()
                    && (isAdmin()
                        || resource.data.dealerCode == userDoc().dealerCode);
      allow write: if isAdmin();
    }

    // ========================================
    // chatRooms コレクション（社内チャット）
    // ログイン済みスタッフ全員が読み書き可
    // ========================================
    match /chatRooms/{roomId} {
      // 親ルームへのアクセス可否を一元化。messages / readers からも使う。
      // - admin/staff/master: 全ルーム可
      // - dealer: roomId == 'dealer_' + 自社 dealerCode のみ
      // - salon: salon_*_hq パターンのみ（salon 間の可視化は既知の制限）
      function canAccessRoom() {
        return isSignedIn() && (
          isAdmin() || isStaff()
          || (isDealer()
              && userDoc().get('dealerCode', '') != ''
              && roomId == ('dealer_' + userDoc().dealerCode))
          || (isSalon() && roomId.matches('^salon_.+_hq$'))
        );
      }

      allow read, write: if canAccessRoom();

      match /messages/{msgId} {
        allow read:   if canAccessRoom();
        allow create: if canAccessRoom()
                       && request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if canAccessRoom()
                       && resource.data.uid == request.auth.uid;
      }

      match /readers/{readerId} {
        allow read, write: if canAccessRoom();
      }
    }

    // ========================================
    // inventoryMasters コレクション（在庫マスタ設定：ブランド・分類・倉庫）
    // admin / staff が読み書き可
    // ========================================
    match /inventoryMasters/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    // ========================================
    // products コレクション（在庫管理：商品マスタ）
    // admin / staff / warehouse が操作可。削除は admin のみ
    // ========================================
    match /products/{docId} {
      allow read:  if isSignedIn();
      allow create: if hasInventoryAccess();
      allow update: if hasInventoryAccess();
      allow delete: if isAdmin();
    }

    // ========================================
    // productCosts コレクション（原価マスタ：商品名 → 単価原価）
    // admin / staff が読み書き可
    // ========================================
    match /productCosts/{docId} {
      allow read:   if isSignedIn() && (isAdmin() || isStaff());
      allow write:  if isAdmin() || isStaff();
    }

    // ========================================
    // stockHistory コレクション（入出庫履歴）
    // admin / staff / warehouse が書き込み可。削除は admin のみ
    // ========================================
    match /stockHistory/{docId} {
      allow read:   if isSignedIn();
      allow create: if hasInventoryAccess();
      allow update: if hasInventoryAccess();
      allow delete: if isAdmin();
    }

    // ========================================
    // allowedEmails コレクション（ログイン許可リスト）
    // 全員が読める（ログイン時のチェックに必要）
    // 書き込みは admin のみ
    // ========================================
    match /allowedEmails/{docId} {
      allow read:  if true;
      // write 時に dealer/salon 招待なら subRole 必須。
      // 管理者は admin なのですぐ通常書き込みできるが、subRole 欠損の招待レコードは
      // 後続のログイン時にユーザーが lockout されてしまうためここで阻止する。
      allow write: if isAdmin()
                    && hasRequiredSubRoleForInvite(request.resource.data);
    }

    // ========================================
    // settings コレクション（権限設定など）
    // 全員読める（権限チェックに必要）。書き込みは admin のみ
    // ========================================
    match /settings/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ========================================
    // publicReceipts コレクション（公開領収書）
    // お客様がメールのリンクからダウンロードするために認証不要で読める
    // 書き込みは admin のみ（Bカート取り込み時に自動生成）
    // ========================================
    match /publicReceipts/{docId} {
      allow read:  if true;
      allow write: if isAdmin() || isStaff();
    }

    // ========================================
    // invoices コレクション（グループC代理店向け請求書）
    // admin は全件読み書き。dealer は自社の請求書のみ読める
    // ========================================
    match /invoices/{docId} {
      allow read:  if isSignedIn()
                    && (isAdmin()
                        || resource.data.dealerCode == userDoc().dealerCode);
      allow write: if isAdmin();
    }

    // ========================================
    // dealerDocuments コレクション（代理店・サロン向け資料）
    // visibility ベースのアクセス制御:
    //   - all      : 全ログインユーザー
    //   - dealers  : dealer + admin/master/staff
    //   - salons   : salon + admin/master/staff
    //   - specific : allowedDealers または allowedCompanies に一致する相手のみ
    //                (admin/master/staff は常に読める)
    // isActive == false は admin/master/staff 以外不可視。
    // 書き込みは admin のみ。
    // ========================================
    function canReadDealerDocument() {
      let vis = resource.data.get('visibility', 'all');
      let isActive = resource.data.get('isActive', true);
      return isSignedIn() && (
        isAdmin() || isStaff()
        || (
          isActive != false && (
            vis == 'all'
            || (vis == 'dealers' && isDealer())
            || (vis == 'salons' && isSalon())
            || (vis == 'specific' && (
                 (isDealer()
                   && userDoc().get('dealerCode', '') != ''
                   && userDoc().dealerCode in resource.data.get('allowedDealers', []))
                 || (isSalon()
                   && userDoc().get('companyName', '') != ''
                   && userDoc().companyName in resource.data.get('allowedCompanies', []))
               ))
          )
        )
      );
    }
    match /dealerDocuments/{docId} {
      allow read:  if canReadDealerDocument();
      allow write: if isAdmin();
    }

    // ========================================
    // メルマガ関連コレクション
    // admin のみ読み書き可
    // ========================================
    match /newsletters/{docId} {
      allow read, write: if isAdmin();
    }
    match /nl_readers/{docId} {
      allow read:   if isAdmin();
      allow write:  if isAdmin();
      // 公開フォームからの登録・解除（認証不要）
      allow create: if request.resource.data.source == 'form'
                     && request.resource.data.email is string
                     && request.resource.data.consentMethod == 'web_form';
      allow update: if resource.data.email is string
                     && request.resource.data.status == 'unsubscribed'
                     && request.resource.data.unsubscribeMethod == 'web_form';
    }
    match /nl_templates/{docId} {
      allow read, write: if isAdmin();
    }
    match /nl_logs/{docId} {
      allow read, write: if isAdmin();
    }

    // ========================================
    // purchases コレクション（工場への発注管理）
    // admin / staff は全件読み書き可
    // ========================================
    match /purchases/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }

    // ========================================
    // quotations コレクション（見積書管理）
    // admin / staff は全件読み書き可
    // ========================================
    match /quotations/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }

    // ========================================
    // orderInvoices コレクション（受注に紐づく請求書）
    // admin / staff は全件読み書き可
    // ========================================
    match /orderInvoices/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }

    // ========================================
    // BPマスタコレクション（取引先・商品・仕入れ先・納品先）
    // 会社別: rt_bp_*, rc_bp_*
    // admin / staff は全件読み書き可
    // ========================================
    match /rt_bp_clients/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }
    match /rt_bp_products/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }
    match /rt_bp_suppliers/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }
    match /rt_bp_destinations/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }
    match /rc_bp_clients/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }
    match /rc_bp_products/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }
    match /rc_bp_suppliers/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }
    match /rc_bp_destinations/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }
    // 旧コレクション（互換性）
    match /bp_clients/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }
    match /bp_products/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }
    match /bp_suppliers/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }
    match /bp_destinations/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }

    // ========================================
    // rt_projects コレクション（ロイヤルトラスト案件管理）
    // admin / staff は全件読み書き可
    // ========================================
    match /rt_projects/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }

    // ========================================
    // rc_projects コレクション（ロイヤルコスメ案件管理）
    // admin / staff は全件読み書き可
    // ========================================
    match /rc_projects/{docId} {
      allow read:  if isSignedIn() && (isAdmin() || isStaff());
      allow write: if isAdmin() || isStaff();
    }

    // ========================================
    // customers コレクション（サロン管理：エンドユーザー顧客マスタ）
    // サロンは自社（companyName 一致）の顧客のみ読み書き可
    // ただし subRole='staff' は書き込み不可（閲覧のみ）
    // 本社 admin/staff は集計用に全件読めるが、画面側で個別表示しない運用
    // ========================================
    match /customers/{customerId} {
      allow read:   if isSignedIn()
                     && (isAdmin() || isStaff()
                         || resource.data.salonCompanyName == userDoc().companyName);

      // create: 現場運用優先で salonAdmin / salonStaff 両方可（本社 admin/staff も可）
      allow create: if isSignedIn()
                     && (isAdmin() || isStaff()
                         || ((isSalonAdmin() || isSalonStaff())
                             && request.resource.data.salonCompanyName == userDoc().companyName));

      // update: 破壊系なので salonAdmin のみ（salonStaff は既存データ壊せない）
      allow update: if isSignedIn()
                     && (isAdmin() || isStaff()
                         || (isSalonAdmin()
                             && resource.data.salonCompanyName == userDoc().companyName));

      // delete: salonAdmin または本社 admin のみ
      allow delete: if isAdmin()
                     || (isSalonAdmin() && resource.data.salonCompanyName == userDoc().companyName);

      // 来店履歴サブコレクション
      // create: サロン admin/staff 両方可（現場運用優先）
      // update: salonAdmin + 本社admin、および salonStaff の「自分が作成した visit」のみ
      // delete: salonAdmin + 本社admin のみ（破壊系は staff 不可）
      match /visits/{visitId} {
        allow read:  if isSignedIn()
                      && (isAdmin() || isStaff() || isMyCustomer(customerId));
        allow create: if isSignedIn()
                       && (isAdmin()
                           || ((isSalonAdmin() || isSalonStaff()) && isMyCustomer(customerId)));
        // update の条件:
        //   createdBy は不変（全ルートで rewrite 禁止。salonStaff による権限奪取対策）
        //   かつ以下のいずれか:
        //     - 本社 admin
        //     - salonAdmin かつ 自社顧客
        //     - salonStaff かつ 自社顧客 かつ 自分が作成した visit
        allow update: if isSignedIn()
                       && request.resource.data.createdBy == resource.data.createdBy
                       && (isAdmin()
                           || (isMyCustomer(customerId)
                               && (isSalonAdmin()
                                   || (isSalonStaff()
                                       && resource.data.createdBy == request.auth.uid))));
        // delete は salonStaff 不可（破壊系は管理者のみ）
        allow delete: if isSignedIn()
                       && (isAdmin() || (isSalonAdmin() && isMyCustomer(customerId)));
      }

      // おすすめ履歴サブコレクション（visits と同等のポリシー）
      match /recommendations/{recoId} {
        allow read:  if isSignedIn()
                      && (isAdmin() || isStaff() || isMyCustomer(customerId));
        allow create: if isSignedIn()
                       && (isAdmin()
                           || ((isSalonAdmin() || isSalonStaff()) && isMyCustomer(customerId)));
        allow update, delete: if isSignedIn()
                               && (isAdmin() || (isSalonAdmin() && isMyCustomer(customerId)));
      }
    }

    // ========================================
    // reservations コレクション（Square予約連動）
    // - 予約の正本は Square、これは取り込み用の閲覧コピー
    // - read: salon は自社（salonCompanyName 一致）のみ、admin/staff/master は全件
    // - write: admin/staff のみ（同期スクリプト経由の書き込みも Admin SDK でバイパスする想定）
    //   salon からは直接書き込み不可（Square が正本のため）
    // ========================================
    match /reservations/{reservationId} {
      allow read:  if isSignedIn()
                    && (isAdmin() || isStaff()
                        || (isSalon()
                            && resource.data.salonCompanyName == userDoc().companyName));
      allow write: if isAdmin() || isStaff();
    }

    // ========================================
    // squareSyncLogs コレクション（Square予約同期スクリプトの監査ログ）
    // - write: 完全禁止（scripts/sync-square-bookings.mjs が Admin SDK で書き込む）
    // - read: 本社 admin のみ（社内の監査目的）
    // ========================================
    match /squareSyncLogs/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ========================================
    // subRoleBackfillLogs コレクション（subRole 一括付与スクリプトの監査ログ）
    // - write: 完全禁止（scripts/backfill-subrole.mjs が Admin SDK で直接書き込む）
    // - read: 本社 admin のみ（社内の監査目的でのみ参照可）
    // ========================================
    match /subRoleBackfillLogs/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ========================================
    // ordersBackfillLogs コレクション（orders.dealerCode バックフィル監査ログ）
    // - write: 完全禁止（scripts/backfill-dealer-code.mjs が Admin SDK で直接書き込む）
    // - read: 本社 admin のみ（failedEntries の人手調査用）
    // ========================================
    match /ordersBackfillLogs/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ========================================
    // salonProducts コレクション（サロン管理：店販レコメンド用商品マスタ）
    // 全サロンが共有するカタログ。読み取りはログイン済み全員、書き込みは admin/staff のみ
    // ========================================
    match /salonProducts/{productId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    // ========================================
    // lineConfigs コレクション（サロン別 LINE Messaging API 設定）
    // docId = salonCompanyName。サロン本人と admin のみ
    // ========================================
    match /lineConfigs/{salonCompanyName} {
      allow read:  if isSignedIn()
                    && (isAdmin() || salonCompanyName == userDoc().companyName);
      allow write: if isSignedIn()
                    && (isAdmin() || salonCompanyName == userDoc().companyName);
    }

    // ========================================
    // ERP Phase 1: 基幹業務 collection
    // 設計書: docs/04_ERP_DATA_MODEL.md
    // 原則: admin / internal(=staff) のみ read/write。物理削除禁止（delete: false）
    // ========================================

    // erp_orders（受注）
    match /erp_orders/{id} {
      allow read, create, update: if isErpUser();
      allow delete: if false;
    }

    // erp_purchase_orders（発注）
    match /erp_purchase_orders/{id} {
      allow read, create, update: if isErpUser();
      allow delete: if false;
    }

    // erp_inventory（在庫）
    match /erp_inventory/{id} {
      allow read: if isErpUser();
      // 直接書き込みは admin のみ（楽観ロックで整合性管理）
      allow create, update: if isErpUser();
      allow delete: if false;
    }

    // erp_stock_ins（入庫）
    match /erp_stock_ins/{id} {
      allow read, create, update: if isErpUser();
      allow delete: if false;
    }

    // erp_shipments（出荷）
    // update 可能 field は極小セット。items/orderId/correctionOf は不変
    match /erp_shipments/{id} {
      allow read, create: if isErpUser();
      allow update: if isErpUser()
                     // correctionOf は一度設定したら変更禁止
                     && (resource.data.correctionOf == null
                         || resource.data.correctionOf == request.resource.data.correctionOf)
                     // supersededBy は null の時のみ書き換え可
                     && (resource.data.supersededBy == null
                         || resource.data.supersededBy == request.resource.data.supersededBy);
      allow delete: if false;
    }

    // erp_external_raw（外部システム生データ、Order 本体から分離保存）
    // payload は一度書いたら変更禁止。orderId のみ後から update 可能
    match /erp_external_raw/{id} {
      allow read, create: if isErpUser();
      allow update: if isErpUser()
                     // payload は不変
                     && resource.data.payload == request.resource.data.payload
                     && resource.data.source == request.resource.data.source
                     && resource.data.externalOrderId == request.resource.data.externalOrderId;
      allow delete: if false;
    }

    // audit_logs（監査ログ、append-only）
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isErpUser();
      allow update, delete: if false;
    }

    // ========================================
    // Phase 2 段階1: 自動化監査コレクション群
    // 設計書: docs/05_PHASE2_AUTOMATION.md §3.2 / §3.6
    //
    // 共通ポリシー:
    //   - read は admin のみ
    //   - create / update / delete はクライアントから不可
    //     （すべて Cloud Functions Admin SDK 経由で書き込む）
    //   - Admin SDK は rules をバイパスするため、本 rule は「クライアント遮断」が目的
    //
    // 段階1 初期配備時の挙動（v1.1 軽微5 補足）:
    //   settings/settlement_automation.enabled = false の間は、
    //   Cloud Functions 側も実質的に書き込みを行わない（関数冒頭の enabled チェックで
    //   即 return するため）。結果として本 rule の 3 コレクションは
    //   「クライアントも Cloud Functions も書き込めない完全静止状態」から始まる。
    //   enabled=true に社長判断で切り替えて初めて Cloud Functions 経由の書き込みが始まる。
    //
    // 注意:
    //   今回（段階1 Step D）は以下 3 コレクションのみ追加する。
    //   kickbacks / invoices の既存 rules は今回は変更しない（既存 UI 非破壊）。
    //   rules 厳格化は後続段階で行う。
    // ========================================

    // settlementRunLogs: 月次バッチ実行単位の監査ログ（append-only）
    match /settlementRunLogs/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // settlementDuplicateChecks: 二重作成・二重送信の検知結果（append-only）
    // kind: 'creation' | 'email' フィールドで種別を区別（§3.5 v0.8）
    match /settlementDuplicateChecks/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // adminNotifications: admin 通知キュー + fan-out 結果
    // create / delete は禁止。update は readBy / acknowledged 系フィールドのみ
    // （admin が UI 上で既読・対応済みにできるようにする）
    match /adminNotifications/{id} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
                     && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['readBy', 'acknowledgedAt', 'acknowledgedBy']);
    }

    // ========================================
    // trainingTypes コレクション（研修種別マスタ）
    // PR-1 導入（2026-04-21）。研修管理機能の骨組み。
    // - admin のみ読み書き可（RS / 代理店 / サロン は今回スコープ外）
    // - 物理削除は禁止（isActive = false の論理削除で運用）
    // ========================================
    match /trainingTypes/{typeId} {
      allow read:  if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ========================================
    // trainingApplications コレクション（研修案件本体）
    // PR-1 導入（2026-04-21）。PR-2 で documents / documentHistory を追加。
    // - admin のみ読み書き可
    // - 物理削除は禁止（cancelled ステータスで運用）
    // - history              : ステータス変更履歴（追記型）
    // - documents            : 発行物（PR-2 追加、採番フィールド不変チェック付き）
    // - documentHistory      : 発行・再印刷の追記型履歴
    // ========================================
    match /trainingApplications/{appId} {
      allow read:  if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;

      // ステータス変更履歴（追記型）
      match /history/{historyId} {
        allow read:   if isAdmin();
        allow create: if isAdmin()
                       && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }

      // 発行物サブコレクション（PR-2）
      // create で採番フィールドを含めて固定、update では採番系を不変に保つ
      match /documents/{docId} {
        allow read:   if isAdmin();
        allow create: if isAdmin();
        // 採番系（documentType / documentNumber / numberYear / numberSeq / issuedAt）は不変
        allow update: if isAdmin()
                       && resource.data.documentType == request.resource.data.documentType
                       && resource.data.documentNumber == request.resource.data.documentNumber
                       && resource.data.numberYear == request.resource.data.numberYear
                       && resource.data.numberSeq == request.resource.data.numberSeq
                       && resource.data.issuedAt == request.resource.data.issuedAt;
        allow delete: if false;
      }

      // 発行・再印刷の履歴（追記型・PR-2）
      // history と同じく actorUid スプーフィング対策付き
      match /documentHistory/{historyId} {
        allow read:   if isAdmin();
        allow create: if isAdmin()
                       && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ========================================
    // counters コレクション（研修発行物の採番カウンタ・PR-2）
    // docId は `trainingDocuments_{diploma|certified_salon_award}_YYYY` 限定。
    // クライアント側 transaction で +1 する前提のため admin に write を許可。
    // 将来、他用途の counters を追加する場合は別の正規表現で個別に許可する。
    // ========================================
    match /counters/{docId} {
      allow read:  if isAdmin()
                    && docId.matches('^trainingDocuments_(diploma|certified_salon_award)_[0-9]{4}$');
      allow write: if isAdmin()
                    && docId.matches('^trainingDocuments_(diploma|certified_salon_award)_[0-9]{4}$');
    }

    // ========================================
    // dealerMonthlySnapshots コレクション（代理店ダッシュボード用 日次スナップショット）
    // docId = {dealerCode}_{YYYY-MM}
    // - write: 完全禁止（scripts/aggregate-dealer-monthly.mjs が Admin SDK で直接書き込む）
    // - read: admin/staff は全件、dealer は自社 dealerCode のみ
    //         （docId ベース判定。resource.data ベースだと評価タイミング差で
    //          PERMISSION_DENIED が出るケースがあるため避ける）
    // ========================================
    match /dealerMonthlySnapshots/{docId} {
      allow read:  if isAdmin() || isStaff()
                    || (isDealer()
                        && userDoc().get('dealerCode', '') != ''
                        && docId.split('_')[0] == userDoc().dealerCode);
      allow write: if false;
    }

    // ========================================
    // dealerAggregationLogs コレクション（代理店スナップショット集計スクリプトの監査ログ）
    // - write: 完全禁止（aggregate-dealer-monthly.mjs のみ）
    // - read: 本社 admin のみ
    // ========================================
    match /dealerAggregationLogs/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ========================================
    // それ以外は全拒否（保険）
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
