# このファイルを .env.local にコピーして実際の値を入れてください。
# .env.local は .gitignore 済み。実値は絶対にコミットしないこと。

# --- Firebase Web SDK 設定 ---
# Firebase Console → プロジェクト設定 → 全般 → マイアプリ からコピー
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- ログイン制限 ---
# 空欄にすると全ドメイン許可（開発時のみ推奨）
VITE_ALLOWED_EMAIL_DOMAIN=

# --- Bカート API トークン ---
# scripts/bcart-sync.mjs / backfill-items.mjs / debug-items*.mjs で使用
VITE_BCART_API_TOKEN=

# --- スクリプト用 Firebase 認証情報（Node スクリプト専用） ---
# Bカート同期スクリプトが Firestore に書き込むためのサービスアカウント
SCRIPT_FIREBASE_EMAIL=
SCRIPT_FIREBASE_PASSWORD=

# 倉庫アカウント（products コレクション書き込み権限あり）
# scripts/sync-warehouse-name.mjs / update-warehouse-user-name.mjs で使用
WAREHOUSE_FIREBASE_EMAIL=
WAREHOUSE_FIREBASE_PASSWORD=
